From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UHK SDK Setup <setup@localhost>
Date: Fri, 9 Oct 2026 19:25:00 -0600
Subject: [PATCH] Trace experimental USB reset setup and power events

Temporary diagnostics count bus reset, setup and resume as well as start/stop.
Do not read USBPULLUP in low power; mark its snapshot unavailable. Disabled
without CONFIG_UHK_USB_LEFT_RELAY. No recovery decisions use these counters.

diff --git a/drivers/usb/udc/udc_nrf.c b/drivers/usb/udc/udc_nrf.c
index 0793021d5..f46657fe9 100644
--- a/drivers/usb/udc/udc_nrf.c
+++ b/drivers/usb/udc/udc_nrf.c
@@ -49,6 +49,13 @@ enum udc_nrf_event_type {
 
 /* Main events the driver thread waits for */
 static K_EVENT_DEFINE(drv_evt);
+
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+/* Temporary USB bus-order diagnostics for the experimental left relay. */
+atomic_t UhkNrfUsbDiag[13];
+#endif
+
+
 /* Transfer triggers */
 static atomic_t xfer_new;
 /* Finished transactions */
@@ -396,6 +403,9 @@ static inline void usbd_int_rise(void)
 
 static void ev_usbreset_handler(void)
 {
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+	atomic_inc(&UhkNrfUsbDiag[8]);
+#endif
 	m_bus_suspend = false;
 
 	LOG_INF("Reset");
@@ -485,6 +495,9 @@ static void usbd_in_packet_sent(uint8_t ep)
 
 static void ev_setup_handler(void)
 {
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+	atomic_inc(&UhkNrfUsbDiag[9]);
+#endif
 	LOG_DBG("USBD event: Setup (rt:%.2x r:%.2x v:%.4x i:%.4x l:%u )",
 		       NRF_USBD->BMREQUESTTYPE, NRF_USBD->BREQUEST,
 		       NRF_USBD->WVALUEL | (NRF_USBD->WVALUEH << 8),
@@ -505,6 +518,9 @@ static void ev_setup_handler(void)
 static void ev_usbevent_handler(void)
 {
 	uint32_t event = NRF_USBD->EVENTCAUSE;
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+	atomic_set(&UhkNrfUsbDiag[12], event);
+#endif
 
 	/* Clear handled events */
 	NRF_USBD->EVENTCAUSE = event;
@@ -736,6 +752,9 @@ static inline void usbd_errata_187_211_end(void)
 
 static void nrf_usbd_peripheral_enable(void)
 {
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+	atomic_inc(&UhkNrfUsbDiag[0]);
+#endif
 	if (nrf_usbd_common_errata_187()) {
 		usbd_errata_187_211_begin();
 	}
@@ -923,6 +942,9 @@ static void nrf_usbd_legacy_disable(void)
 
 static void nrf_usbd_legacy_start(bool enable_sof)
 {
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+	atomic_inc(&UhkNrfUsbDiag[2]);
+#endif
 	m_bus_suspend = false;
 
 	uint32_t int_mask = USBD_INTEN_USBRESET_Msk | USBD_INTEN_ENDEPIN0_Msk |
@@ -950,10 +972,17 @@ static void nrf_usbd_legacy_start(bool enable_sof)
 
 	/* Enable pullups */
 	NRF_USBD->USBPULLUP = 1;
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+	uint32_t low = NRF_USBD->LOWPOWER;
+	atomic_set(&UhkNrfUsbDiag[7], low ? 4 : (NRF_USBD->USBPULLUP << 1));
+#endif
 }
 
 static void nrf_usbd_common_stop(void)
 {
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+	atomic_inc(&UhkNrfUsbDiag[3]);
+#endif
 	/* Clear interrupt */
 	NVIC_ClearPendingIRQ(USBD_IRQn);
 
@@ -1436,6 +1465,9 @@ static void udc_nrf_thread_handler(const struct device *dev)
 	evt = k_event_clear(&drv_evt, UINT32_MAX);
 
 	if (evt & BIT(UDC_NRF_EVT_SUSPEND)) {
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+		atomic_inc(&UhkNrfUsbDiag[4]);
+#endif
 		LOG_INF("SUSPEND state detected");
 		nrf_usbd_legacy_suspend();
 		udc_set_suspended(dev, true);
@@ -1443,6 +1475,9 @@ static void udc_nrf_thread_handler(const struct device *dev)
 	}
 
 	if (evt & BIT(UDC_NRF_EVT_RESUME)) {
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+		atomic_inc(&UhkNrfUsbDiag[10]);
+#endif
 		LOG_INF("RESUMING from suspend");
 		udc_set_suspended(dev, false);
 		udc_submit_event(dev, UDC_EVT_RESUME, 0);
@@ -1533,6 +1568,10 @@ static void udc_nrf_thread(void *p1, void *p2, void *p3)
 
 static void udc_nrf_power_handler(nrfx_power_usb_evt_t pwr_evt)
 {
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+	atomic_set(&UhkNrfUsbDiag[6], pwr_evt);
+	if (pwr_evt == NRFX_POWER_USB_EVT_READY) { atomic_inc(&UhkNrfUsbDiag[1]); }
+#endif
 	switch (pwr_evt) {
 	case NRFX_POWER_USB_EVT_DETECTED:
 		LOG_DBG("POWER event detected");
@@ -1717,6 +1756,9 @@ static int udc_nrf_enable(const struct device *dev)
 	/* Disable interrupts until USBD is enabled */
 	key = irq_lock();
 	nrf_usbd_legacy_enable();
+#ifdef CONFIG_UHK_USB_LEFT_RELAY
+	atomic_set(&UhkNrfUsbDiag[5], nrfx_power_usbstatus_get() | (NRF_USBD->LOWPOWER << 2) | (m_bus_suspend << 4));
+#endif
 	/* USB ready can precede the stack's deferred controller enable. */
 	if (nrfx_power_usbstatus_get() == NRFX_POWER_USB_STATE_READY) {
 		nrf_usbd_legacy_start(IS_ENABLED(CONFIG_UDC_ENABLE_SOF));
