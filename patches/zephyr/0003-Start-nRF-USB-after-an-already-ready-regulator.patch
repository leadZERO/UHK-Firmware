From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UHK SDK Setup <setup@localhost>
Date: Fri, 9 Oct 2026 18:30:00 -0600
Subject: [PATCH] Start nRF USB after an already-ready regulator

The stack may defer controller enable until after the regulator READY event.
Do not start an inactive peripheral in the power callback. On enable, check the
current ready level and start if necessary instead of depending on another edge.

diff --git a/drivers/usb/udc/udc_nrf.c b/drivers/usb/udc/udc_nrf.c
--- a/drivers/usb/udc/udc_nrf.c
+++ b/drivers/usb/udc/udc_nrf.c
@@ -1537,6 +1537,8 @@ static void udc_nrf_power_handler(nrfx_power_usb_evt_t pwr_evt)
 	case NRFX_POWER_USB_EVT_READY:
 		LOG_DBG("POWER event ready");
-		nrf_usbd_legacy_start(IS_ENABLED(CONFIG_UDC_ENABLE_SOF));
+		if (NRF_USBD->ENABLE != 0) {
+			nrf_usbd_legacy_start(IS_ENABLED(CONFIG_UDC_ENABLE_SOF));
+		}
 		break;
 	case NRFX_POWER_USB_EVT_REMOVED:
 		LOG_DBG("POWER event removed");
@@ -1710,6 +1712,10 @@ static int udc_nrf_enable(const struct device *dev)
 	key = irq_lock();
 	nrf_usbd_legacy_enable();
+	/* USB ready can precede the stack's deferred controller enable. */
+	if (nrfx_power_usbstatus_get() == NRFX_POWER_USB_STATE_READY) {
+		nrf_usbd_legacy_start(IS_ENABLED(CONFIG_UDC_ENABLE_SOF));
+	}
 	irq_unlock(key);
 
 	return 0;
 }
