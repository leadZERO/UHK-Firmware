From 680153e2042ba8b7db1737f9afd08a3fff2fbfb5 Mon Sep 17 00:00:00 2001
From: UHK SDK Setup <setup@localhost>
Date: Fri, 9 Oct 2026 19:44:20 -0600
Subject: [PATCH] Discard cached SETUP when the controller is disabled

---
 drivers/usb/udc/udc_common.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/usb/udc/udc_common.c b/drivers/usb/udc/udc_common.c
index 1aba923e76b..3da3fd88da8 100644
--- a/drivers/usb/udc/udc_common.c
+++ b/drivers/usb/udc/udc_common.c
@@ -909,6 +909,13 @@ int udc_disable(const struct device *dev)
 
 	ret = api->disable(dev);
 	atomic_clear_bit(&data->status, UDC_STATUS_ENABLED);
+	if (ret == 0) {
+		/* Cached SETUP data belongs to the attachment that just ended.
+		 * A fresh SETUP buffer must not receive that obsolete request.
+		 */
+		data->setup_pending = false;
+		data->setup_valid = false;
+	}
 
 udc_disable_error:
 	api->unlock(dev);
-- 
2.43.0

