From 6c3a27bd7bdf1bd98770f97e3ee8d3073652aa9d Mon Sep 17 00:00:00 2001
From: UHK SDK Setup <setup@localhost>
Date: Fri, 9 Oct 2026 19:44:20 -0600
Subject: [PATCH] Retire fixed control buffers before reattachment

---
 c2usb/port/zephyr/udc_mac.cpp | 110 ++++++++++++++++++++++++++++++++++
 c2usb/port/zephyr/udc_mac.hpp |   7 +++
 2 files changed, 117 insertions(+)

diff --git a/c2usb/port/zephyr/udc_mac.cpp b/c2usb/port/zephyr/udc_mac.cpp
index 2fe16bf..a759f95 100644
--- a/c2usb/port/zephyr/udc_mac.cpp
+++ b/c2usb/port/zephyr/udc_mac.cpp
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: MPL-2.0
 #include "port/zephyr/udc_mac.hpp"
 #include <atomic>
+#include <algorithm>
 #include "compatibility_helper.hpp"
 #include <zephyr/kernel.h>
 #include <zephyr/logging/log.h>
@@ -33,6 +34,10 @@ using namespace usb::df;
 LOG_MODULE_REGISTER(c2usb, CONFIG_C2USB_UDC_MAC_LOG_LEVEL);
 
 static constexpr ::udc_event_type UDC_MAC_TASK = (udc_event_type)-1;
+static constexpr ::udc_event_type UDC_MAC_CONTROL_RETIRED = (udc_event_type)-2;
+// Only the USB worker changes this registry. Two entries match supported MAC
+// instances; retry after every consumed event even when it was an opaque task.
+static std::array<usb::zephyr::udc_mac*, 2> retiring_macs{};
 
 // keeping compatibility with multiple Zephyr versions
 #define UDC_CAPS_FLAG(tret, name, defvalue)                                                        \
@@ -217,6 +222,7 @@ void udc_mac::worker(void*, void*, void*)
     {
         udc_event event = message_queue().get();
         event_callback(event);
+        retry_control_retirements();
     }
 }
 
@@ -298,6 +304,15 @@ bool udc_mac::set_attached(bool attached)
     }
     if (attached)
     {
+        if constexpr (not udc_managed_ctrl)
+        {
+            if (control_retiring_)
+            {
+                // VBUS READY may already be queued ahead of cancellation
+                // completions. The retirement barrier will attach afterwards.
+                return false;
+            }
+        }
         if constexpr (not udc_managed_ctrl)
         {
             bool start_setup = udc_ep_queue_is_empty(dev_, USB_CONTROL_EP_OUT);
@@ -318,12 +333,89 @@ bool udc_mac::set_attached(bool attached)
     }
     else
     {
+        if constexpr (not udc_managed_ctrl)
+        {
+            retire_control();
+        }
         [[maybe_unused]] auto ret = udc_disable(dev_);
         assert(ret == 0 and "Failed to disable UDC");
+
     }
     return udc_is_enabled(dev_);
 }
 
+void udc_mac::retire_control()
+{
+    if (control_retiring_)
+    {
+        return;
+    }
+    // A retained STATUS/DATA buffer is not a SETUP buffer. Empty both
+    // control queues before rearming; keep fixed buffers owned until all
+    // completions from the previous transaction have passed the worker.
+    control_retiring_ = true;
+    [[maybe_unused]] auto ret = udc_ep_dequeue(dev_, USB_CONTROL_EP_IN);
+    assert(ret == 0 and "Failed to retire control IN");
+    ret = udc_ep_dequeue(dev_, USB_CONTROL_EP_OUT);
+    assert(ret == 0 and "Failed to retire control OUT");
+    // Dequeue posts completions before returning. A READY/RESET that was
+    // already queued may run first, but cannot reuse the fixed buffers.
+    auto slot = std::find(retiring_macs.begin(), retiring_macs.end(), nullptr);
+    assert(slot != retiring_macs.end());
+    *slot = this;
+    try_queue_control_retirement();
+}
+
+void udc_mac::try_queue_control_retirement()
+{
+    if (!control_retiring_ or control_barrier_queued_)
+    {
+        return;
+    }
+    // Never block the message queue's sole consumer posting to its own queue.
+    // If dequeue completions filled it, consume events and retry at the tail.
+    // The retirement guard remains closed until that ordered event is read.
+    udc_event event{.type = UDC_MAC_CONTROL_RETIRED, .dev = dev_};
+    control_barrier_queued_ = message_queue().try_post(event);
+}
+
+void udc_mac::retry_control_retirements()
+{
+    for (auto* mac : retiring_macs)
+    {
+        if (mac)
+        {
+            mac->try_queue_control_retirement();
+        }
+    }
+}
+
+void udc_mac::finish_control_retirement()
+{
+    for (auto& mac : retiring_macs)
+    {
+        if (mac == this)
+        {
+            mac = nullptr;
+        }
+    }
+    control_barrier_queued_ = false;
+    control_retiring_ = false;
+    if (active() and power_state() != power::state::L3_OFF)
+    {
+        if (udc_is_enabled(dev_))
+        {
+            // Bus reset keeps the controller powered. A SETUP received while
+            // retiring is cached by UDC and delivered when this buffer returns.
+            ctrl_setup();
+        }
+        else
+        {
+            set_attached(true);
+        }
+    }
+}
+
 usb::result udc_mac::signal_remote_wakeup()
 {
 #if 0
@@ -557,6 +649,11 @@ int udc_mac::event_callback(const udc_event& event)
     }
     auto* mac = get_event_ctx(event.dev);
     assert(mac != nullptr);
+    if (event.type == UDC_MAC_CONTROL_RETIRED) [[unlikely]]
+    {
+        mac->finish_control_retirement();
+        return 0;
+    }
     return mac->process_event(event);
 }
 
@@ -605,9 +702,22 @@ int udc_mac::process_event(const udc_event& event)
     switch (event.type)
     {
     case UDC_EVT_EP_REQUEST:
+        if constexpr (not udc_managed_ctrl)
+        {
+            if (control_retiring_ and endpoint::address(udc_get_buf_info(event.buf)->ep).number() == 0)
+            {
+                // These are fixed buffers, not driver-owned allocations. Do
+                // not rearm or interpret their retired control transaction.
+                break;
+            }
+        }
         process_ep_event(event.buf);
         break;
     case UDC_EVT_RESET:
+        if constexpr (not udc_managed_ctrl)
+        {
+            retire_control();
+        }
         bus_reset();
         {
             [[maybe_unused]] auto ret = udc_set_address(dev_, 0);
diff --git a/c2usb/port/zephyr/udc_mac.hpp b/c2usb/port/zephyr/udc_mac.hpp
index e3672a7..94f71ed 100644
--- a/c2usb/port/zephyr/udc_mac.hpp
+++ b/c2usb/port/zephyr/udc_mac.hpp
@@ -50,6 +50,13 @@ class udc_mac : public df::mac
     ::net_buf* ctrl_buf_{};
     ::net_buf* setup_buf_{};
     ::net_buf* status_buf_{};
+    // Fixed EP0 buffers cannot be reused until their old events have drained.
+    bool control_retiring_{};
+    bool control_barrier_queued_{};
+    void retire_control();
+    void try_queue_control_retirement();
+    static void retry_control_retirements();
+    void finish_control_retirement();
 
     static int event_callback(const ::udc_event& event);
     void set_driver_ctx();
-- 
